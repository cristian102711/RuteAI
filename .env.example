# ============================================================
#  RouteAI — Variables de Entorno Requeridas
#  1. Copia este archivo como ".env" en la raíz del monorepo
#  2. Agrega TODAS estas variables en el dashboard de Vercel
#     (Settings → Environment Variables) para cada proyecto:
#     - ruteai (web)  → todas las que empiezan con NEXT_PUBLIC_ + las privadas
#     - ruteai-auth   → SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
#     - ruteai-core   → DATABASE_URL
# ============================================================

# ── 1. Supabase (Frontend / Anon) ────────────────────────────
# Disponibles en: Supabase Dashboard → Project Settings → API
# Seguro exponerlas al navegador (RLS las protege)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ── 2. Supabase (Backend / Service Role) ─────────────────────
# ⚠️ NUNCA exponer al frontend — solo Server Actions y Route Handlers
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
SUPABASE_ANON_KEY=eyJh...

# ── 3. Base de Datos Prisma ───────────────────────────────────
# Disponible en: Supabase Dashboard → Settings → Database → Connection string
# Usar Transaction Pooler (puerto 6543, con ?pgbouncer=true) para serverless
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexión directa para prisma migrate (Session Pooler, puerto 5432)
DIRECT_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── 4. URL Pública de la Aplicación ──────────────────────────
# Usada para construir URLs de redirect OAuth en producción
# Debe coincidir con el dominio real en Vercel
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# ── 5. URLs de Microservicios (Vercel) ───────────────────────
AUTH_SERVICE_URL=https://ruteai-auth.vercel.app
CORE_SERVICE_URL=https://rute-ai-core.vercel.app
AI_SERVICE_URL=https://ruteai-ai-service.vercel.app

# ── 6. Google Maps ────────────────────────────────────────────
# Obtener en: console.cloud.google.com → APIs & Services → Credentials
# Habilitar: Maps JavaScript API + Directions API + Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_KEY= 

# ── 7. OpenRouter (IA) ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── 8. Twilio (SMS - Opcional) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
