
# Hoist React Native / Expo packages for Metro bundler compatibility
# (Metro requires flat node_modules, Next.js handles workspace isolation fine)
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@react-native-community/*
public-hoist-pattern[]=@react-navigation/*
public-hoist-pattern[]=react-native-*

# Singleton React — evita "Router action dispatched before initialization"
# en Next.js 16 con monorepos pnpm al tener múltiples instancias de React
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=react-is
