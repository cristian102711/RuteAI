PORT=3001
NODE_ENV=development
# URL del frontend (web) — usada para el CORS del ai-service
# En Vercel: agregar en Settings → Environment Variables del proyecto ruteai-ai-service
WEB_URL=https://ruteai.vercel.app

# ── Open Router (IA) ──────────────────────────────────────────
# Score de riesgo de entrega y reorganización de pedidos por prioridad.
# Obtener la key en https://openrouter.ai/keys
# Si OPENROUTER_API_KEY no está configurada, el score cae al algoritmo
# heurístico determinista y la reorganización mantiene el orden original.
OPENROUTER_API_KEY=

# Modelo de Open Router (opcional). Default: openai/gpt-oss-120b:free
# IMPORTANTE: usar un modelo con tier gratuito vigente. Varios modelos
# (p. ej. google/gemini-2.5-flash:free) dejaron de ser gratuitos.
OPENROUTER_MODEL=openai/gpt-oss-120b:free
