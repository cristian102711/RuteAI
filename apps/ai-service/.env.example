PORT=3001
NODE_ENV=development
# URL del frontend (web) — usada para el CORS del ai-service
# En Vercel: agregar en Settings → Environment Variables del proyecto ruteai-ai-service
WEB_URL=https://ruteai.vercel.app

# Gemini API (optimización de rutas con IA). Obtener en https://aistudio.google.com/apikey
# Requiere billing/cuota habilitada en el proyecto de Google Cloud. Si falta o
# devuelve error/429, el ai-service cae automáticamente al heurístico nearest-neighbor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
