# ============================================================
# RUTEAI CORE — Variables de Entorno
# Copia este archivo como .env y completa los valores.
# ============================================================

# ── Base de Datos (Prisma ORM) ────────────────────────────────
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# ── Auth Service ──────────────────────────────────────────────
# El middleware requireAuth valida los tokens contra este servicio.
# Local: http://localhost:3002 · Producción: https://ruteai-auth.vercel.app
AUTH_SERVICE_URL=http://localhost:3002

# ── AI Service (usado por la planificación de rutas / optimize) ──
# Local: http://localhost:3001 · Producción: https://ruteai-ai-service.vercel.app
AI_SERVICE_URL=http://localhost:3001
