{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "src/lib/**/*.ts",
    "src/middlewares/**/*.ts",
    "!src/**/*.d.ts"
  ]
}
