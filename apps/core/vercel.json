{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm --filter @ruteai/core build",
  "installCommand": "cd ../.. && pnpm install",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
