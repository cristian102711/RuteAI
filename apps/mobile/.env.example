# ============================================================
#  RouteAI Mobile — Variables de Entorno (Android)
#  1. Copia este archivo como ".env" dentro de apps/mobile/
#  2. Rellena los valores reales (NO subir el .env a git)
#  Expo carga este .env automáticamente al ejecutar:
#    expo start / expo prebuild / eas build
# ============================================================

# ── Google Maps SDK (Android) ────────────────────────────────
# Obtener en: console.cloud.google.com → APIs & Services → Credentials
# Habilitar en la consola de Google Cloud:
#   - Maps SDK for Android
#   - Directions API  (opcional, para trazar rutas reales)
#   - Geocoding API   (opcional)
#
# ⚠️ Esta key se inyecta en AndroidManifest.xml durante el prebuild,
#    por eso NO lleva el prefijo EXPO_PUBLIC_.
#    Tras pegar la key, ejecuta:  npx expo prebuild --clean
#
# En Google Cloud, restringe esta key con:
#   - Package name: com.ruteai.mobile
#   - SHA-1 del keystore (debug y/o producción)
GOOGLE_MAPS_API_KEY=

# ── Supabase (cliente JS) ────────────────────────────────────
# Sí llevan EXPO_PUBLIC_ porque se usan desde el bundle JavaScript.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ── API Core (backend) ───────────────────────────────────────
EXPO_PUBLIC_API_URL=https://rute-ai-core.vercel.app
