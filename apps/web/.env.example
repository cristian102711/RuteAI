# ============================================================
# RUTEAI WEB — Variables de Entorno
# Copia este archivo como .env y completa los valores.
# NUNCA commitear el .env con valores reales.
# ============================================================

# ── Base de Datos (Prisma ORM) ────────────────────────────────
# Transaction Pooler (para queries en serverless/Vercel)
DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (para prisma migrate)
DIRECT_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres"

# ── Supabase (Frontend — expuesto al navegador) ───────────────
NEXT_PUBLIC_SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_anon_key_aqui"

# ── Supabase (Backend — NUNCA exponer al frontend) ───────────
SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"
SUPABASE_ANON_KEY="tu_anon_key_aqui"

# ── URL pública de la app ─────────────────────────────────────
# Producción: https://ruteai.vercel.app
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL="https://ruteai.vercel.app"

# ── Microservicios ────────────────────────────────────────────
AUTH_SERVICE_URL="https://ruteai-auth.vercel.app"
CORE_SERVICE_URL="https://rute-ai-core.vercel.app"
AI_SERVICE_URL="https://ruteai-ai-service.vercel.app"

# ── APIs externas ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
OPENROUTER_API_KEY=
