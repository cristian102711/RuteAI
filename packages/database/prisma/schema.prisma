// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// 1. EMPRESA
// Cada empresa que contrata RouteAI tendrá su propia cuenta.
// planActivo controla si la suscripción está vigente.
// -------------------------------------------------------------
model Empresa {
  id               String   @id @default(uuid())
  nombre           String
  email            String   @unique
  plan             String   @default("starter") // starter | pro | business
  planActivo       Boolean  @default(false)
  planFechaInicio  DateTime?
  planFechaVencimiento DateTime?
  planEstado       String   @default("inactivo") // "activo" | "inactivo" | "vencido"
  activa           Boolean  @default(true)
  configuracion    Json?    // RUT, país, dirección, notificaciones, ajustes IA
  metodoPago       Json?    // Datos enmascarados: { tipo, ultimos4, expira, titular } — sin número completo
  createdAt        DateTime @default(now())

  usuarios      Usuario[]
  pedidos       Pedido[]
  rutas         Ruta[]
  alertas       Alerta[]
  reportesCache ReporteCache[]
  pagos         Pago[]
}

// -------------------------------------------------------------
// 2. USUARIO (Encargado o Repartidor)
// El id es el mismo UUID de Supabase Auth.
// -------------------------------------------------------------
model Usuario {
  id       String  @id // UUID de Supabase Auth
  nombre   String
  email    String  @unique
  rol      String  @default("repartidor") // "super_admin" | "encargado" | "repartidor"
  telefono String? // Para notificaciones Twilio
  vehiculo String? // Ej: Moto, Auto, Furgón
  patente  String? // Ej: AB-CD-12

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  pedidosAsignados Pedido[]    @relation("RepartidorPedidos")
  rutas            Ruta[]      @relation("RepartidorRutas")
  ubicaciones      Ubicacion[]
  alertas          Alerta[]    @relation("AlertasRepartidor")

  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 3. PEDIDO Y DESPACHO
// Enriquecido con lat/lng y teléfono del cliente para
// geocodificación y notificaciones Twilio.
// -------------------------------------------------------------
model Pedido {
  id               String  @id @default(uuid())
  nombreCliente    String
  clienteTelefono  String? // Para WhatsApp/SMS Twilio
  direccion        String
  lat              Float?  // Geocodificado por Nominatim al crear
  lng              Float?
  producto         String
  horarioPreferido String? // Ej: "10:00 - 13:00" (ventana sugerida, texto libre)

  // IA y Estado
  // estado: pendiente | en_ruta | entregado | fallido | cancelado
  //   - fallido  = se intentó entregar y no se pudo (re-agendable)
  //   - cancelado = pedido anulado, estado TERMINAL (no admite más cambios)
  //   - "atrasado" NO es un estado: se deriva de fechaEntregaLimite (ver lib/logistica)
  estado      String @default("pendiente")
  scoreRiesgo Float? // 0.0 a 1.0 — calculado por microservicio IA

  // SLA / tiempos de entrega
  fechaEntregaLimite DateTime? // Deadline definido por el encargado con el reloj
  despachadoEn       DateTime? // Momento en que pasó a en_ruta
  entregadoEn        DateTime? // Momento real de entrega (para medir OTD / atraso)
  canceladoEn        DateTime? // Momento de cancelación
  intentosEntrega    Int       @default(0) // Re-intentos de entrega fallida

  // Evidencia de entrega (URLs de Supabase Storage)
  fotoEntregaUrl  String?
  firmaEntregaUrl String?
  entregaSinFoto  Boolean @default(false) // Entrega confirmada omitiendo la foto (justificado)
  motivoFallo     String? // Motivo tipificado del fallo (catálogo en lib/logistica)
  motivoCancelacion String? // Motivo tipificado de la cancelación

  // Relaciones
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  repartidorId String?
  repartidor   Usuario? @relation("RepartidorPedidos", fields: [repartidorId], references: [id])

  rutaId String?
  ruta   Ruta?   @relation(fields: [rutaId], references: [id])

  eventos EventoPedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// 3.1 EVENTO DE PEDIDO (Timeline / Auditoría de trazabilidad)
// Cada cambio relevante del pedido deja un evento inmutable.
// Permite reconstruir la historia del despacho para disputas.
// -------------------------------------------------------------
model EventoPedido {
  id             String   @id @default(uuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tipo           String   // creado | despachado | entregado | fallido | cancelado | reintento | atraso
  estadoAnterior String?
  estadoNuevo    String?
  motivo         String?  // Motivo tipificado cuando aplica (fallo / cancelación)
  descripcion    String?
  actorId        String?  // Usuario que ejecutó la acción
  actorNombre    String?
  metadata       Json?    // { minutosAtraso, sinFoto, ... }

  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
}

// -------------------------------------------------------------
// 4. RUTA
// Agrupa pedidos asignados a un repartidor en un día.
// rutaOptimizada guarda el orden calculado por la IA como JSON.
// -------------------------------------------------------------
model Ruta {
  id             String   @id @default(uuid())
  fecha          DateTime @db.Date
  // Catálogo unificado con la API (core + BFF): planificada -> en_curso -> completada | cancelada
  estado         String   @default("planificada") // planificada | en_curso | completada | cancelada
  rutaOptimizada Json?    // Orden de paradas calculado por IA

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  repartidorId String
  repartidor   Usuario @relation("RepartidorRutas", fields: [repartidorId], references: [id])

  pedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// 5. UBICACION (GPS histórico del repartidor)
// Cada ping GPS del repartidor se guarda aquí.
// También alimenta Supabase Realtime para el mapa en vivo.
// -------------------------------------------------------------
model Ubicacion {
  id        String   @id @default(uuid())
  lat       Float
  lng       Float
  velocidad Float?   // km/h reportada por el GPS del repartidor (opcional)
  timestamp DateTime @default(now())

  repartidorId String
  repartidor   Usuario @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  empresaId String

  @@index([repartidorId, timestamp])
}

// -------------------------------------------------------------
// 6. ALERTA
// Generadas automáticamente por la Edge Function de cron.
// Tipos: desvio | retraso | riesgo_alto
// -------------------------------------------------------------
model Alerta {
  id      String  @id @default(uuid())
  tipo    String  // "desvio" | "retraso" | "riesgo_alto"
  mensaje String
  leida   Boolean @default(false)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  repartidorId String?
  repartidor   Usuario? @relation("AlertasRepartidor", fields: [repartidorId], references: [id])

  pedidoId String? // Pedido relacionado (si aplica)

  createdAt DateTime @default(now())

  @@index([empresaId, leida])
}

// -------------------------------------------------------------
// 7. REPORTE CACHE
// Guarda reportes pre-calculados para no recalcular en cada
// carga del dashboard. Clave única por empresa + fecha.
// -------------------------------------------------------------
model ReporteCache {
  id        String   @id @default(uuid())
  fecha     DateTime @db.Date
  datos     Json     // Métricas: entregas, fallos, eficiencia, costos
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([empresaId, fecha])
}

// -------------------------------------------------------------
// 8. LOG ACCESO (Auditoría de Inicios de Sesión)
// -------------------------------------------------------------
model LogAcceso {
  id        String   @id @default(uuid())
  email     String
  estado    String   // "exito" | "error"
  detalles  String?  // Ej: motivo del fallo o metadata
  ip        String?
  timestamp DateTime @default(now())
}

// -------------------------------------------------------------
// 9. PAGO (Integración con Flow)
// Registra cada transacción de pago de planes
// -------------------------------------------------------------
model Pago {
  id            String   @id @default(cuid())
  commerceOrder String   @unique  // Ej: ruteai-abc123-1734567890
  flowOrder     String?            // ID de Flow (viene después del pago)
  empresaId     String?
  empresa       Empresa?  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  planId        String            // starter | pro | business
  monto         Int               // Monto en CLP (29000, 99000, 199000)
  estado        String   @default("pendiente") // pendiente | pagado | rechazado | anulado
  token         String?           // Token de Flow para consultas
  pagadoEn      DateTime?
  fechaVencimiento DateTime?      // Solo si es suscripción recurrente
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([commerceOrder])
  @@index([empresaId])
  @@index([estado])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 10. INVITACION PENDIENTE
// Guarda los datos pre-llenados de un repartidor invitado por email.
// El repartidor hace click en el link, ve sus datos y los completa.
// Se elimina cuando el repartidor completa su registro.
// -------------------------------------------------------------
model InvitacionPendiente {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  telefono  String?
  vehiculo  String?
  patente   String?
  empresaId String
  creadoPor String   // ID del encargado que invitó
  createdAt DateTime @default(now())
  expiraEn  DateTime // 7 días de validez

  @@index([email])
  @@index([empresaId])
}