// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// 🏢 1. EMPRESA
// Cada empresa que contrata RouteAI tendrá su propia cuenta.
// -------------------------------------------------------------
model Empresa {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  plan      String   @default("starter") // starter, pro, business
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relaciones
  usuarios  Usuario[]
  pedidos   Pedido[]
  alertas   Alerta[]
}

model Usuario {
  id        String   @id // UUID de Supabase Auth
  nombre    String
  email     String   @unique
  rol       String   @default("repartidor") // "encargado" | "repartidor"
  
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  pedidosAsignados Pedido[] @relation("RepartidorPedidos")
  alertas          Alerta[] @relation("AlertasRepartidor")

  createdAt DateTime @default(now())
}

model Pedido {
  id                String   @id @default(uuid())
  nombreCliente     String
  direccion         String
  producto          String
  horarioPreferido  String?  // Ej: "10:00 - 13:00"
  
  estado            String   @default("pendiente") // pendiente, en_ruta, entregado, fallido
  scoreRiesgo       Int?     // Porcentaje de riesgo (0-100)
  
  fotoEntregaUrl    String?
  firmaEntregaUrl   String?
  motivoFallo       String?

  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  repartidorId      String?
  repartidor        Usuario? @relation("RepartidorPedidos", fields: [repartidorId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Alerta {
  id      String  @id @default(uuid())
  tipo    String  // "desvio" | "retraso" | "riesgo_alto"
  mensaje String
  leida   Boolean @default(false)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  repartidorId String?
  repartidor   Usuario? @relation("AlertasRepartidor", fields: [repartidorId], references: [id])

  pedidoId String? // Pedido relacionado

  createdAt DateTime @default(now())

  @@index([empresaId, leida])
}

